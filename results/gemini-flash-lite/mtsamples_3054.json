  "procedures": [],
  "course": {
    "narrative": "A 68-year-old man with a history of CAD, heart failure, diabetes, and stage III CKD was evaluated for acute on chronic renal failure after routine labs showed a creatinine elevation to 2.3. He reported taking multiple Chinese herbs and dietary supplements for a year until stopping 2-3 weeks prior. He also experienced morning dizziness, low home blood pressure readings, and weight loss. Physical exam showed orthostatic changes. Lab work demonstrated elevated BUN, creatinine, and a CK of 653. The clinician suspected prerenal azotemia, potential urinary obstruction, chronic interstitial nephritis from herbs, and statin/fibrate myositis. Recommendations included stopping Crestor, decreasing dosages of atenolol, enalapril, and Lasix, avoiding NSAIDs and Chinese herbs, obtaining a renal ultrasound, drawing repeat labs, and following up in two weeks.",
    "evidence": [
      {
        "doc_id": "d1",
        "start": 5483,
        "end": 5515
      }
    ]
  },
